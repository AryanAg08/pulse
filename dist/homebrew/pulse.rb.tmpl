# Generated by `make formula VERSION=…`. Copy to a homebrew-tap repository as
# Formula/pulse.rb; do not edit the generated file by hand.
class Pulse < Formula
  desc "Context-aware assistant for developers that mostly stays quiet"
  homepage "https://github.com/AryanAg08/pulse"
  url "@URL@"
  sha256 "@SHA@"
  license "MIT"   # requires a LICENSE file in the repository
  head "https://github.com/AryanAg08/pulse.git", branch: "master"

  depends_on "go" => :build
  # Pulse reads GitHub through the gh CLI rather than storing a token itself,
  # so gh is a runtime dependency, not an optional convenience.
  depends_on "gh"

  def install
    ldflags = "-s -w -X main.version=#{version}"
    system "go", "build", *std_go_args(ldflags: ldflags), "."
  end

  def caveats
    <<~EOS
      Set up with:
        pulse init      # asks about your day and routines
        pulse doctor    # checks the install and names the fix for anything broken

      macOS attributes notification banners to Script Editor. If `pulse doctor`
      reports no banner, allow it in:
        System Settings -> Notifications -> Script Editor
      Without that permission every nudge is logged and never shown.
    EOS
  end

  test do
    assert_match "pulse #{version}", shell_output("#{bin}/pulse version")
    # `pulse` with no arguments prints the command list and exits cleanly.
    assert_match "context-aware assistant", shell_output("#{bin}/pulse")
  end
end
